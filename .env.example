# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security Configuration
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
LOG_LEVEL="info"

# ---- Supabase Auth ----
# From your Supabase project -> Project Settings -> API.
# VITE_* is bundled into the client; the anon key is public/safe to expose.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# ---- Hugging Face (image-to-3D) ----
# SERVER-SIDE ONLY. No VITE_ prefix, so it is never exposed to the browser.
# Read only by the Express /api/generate-3d endpoint.
HF_API_TOKEN="YOUR_HUGGINGFACE_TOKEN"

# ---- Resend (auth email SMTP) ----
# NOT read by this app. Configure inside the Supabase dashboard:
# Authentication -> Emails -> SMTP: host smtp.resend.com, port 465, user "resend",
# password = your Resend API key, sender = your verified domain.
# RESEND_API_KEY="YOUR_RESEND_API_KEY"

# ---- VSTY Hardware Integration (Local Host Only) ----
# Operating mode: "SIMULATION" (default, safe for dev/cloud) or "REAL" (local physical controller).
HARDWARE_MODE="SIMULATION"

# Master controller board ("ARDUINO_UNO_R3") and serial port (e.g., "COM3" on Windows or "/dev/ttyACM0" on Linux).
# Leave SERIAL_PORT blank until verified in Device Manager / ls /dev/tty*.
CONTROLLER_BOARD="ARDUINO_UNO_R3"
SERIAL_PORT=""
SERIAL_BAUD_RATE="115200"
SERIAL_HANDSHAKE_TIMEOUT_MS="3500"
SERIAL_COMMAND_TIMEOUT_MS="1500"
TELEMETRY_STALE_MS="3000"

# Analog Turbidity Sensor (Arduino Pin A0)
# Calibration requires two verified reference standards (clear water & known NTU standard).
# Keep TURBIDITY_CALIBRATED="false" until physical two-point calibration is performed.
TURBIDITY_CALIBRATED="false"
# TURBIDITY_CLEAR_WATER_VOLTAGE="4.10"
# TURBIDITY_REFERENCE_NTU_VOLTAGE="2.50"
# TURBIDITY_REFERENCE_NTU_VALUE="1000"

# Optional Sensors (Set to "true" ONLY when physically wired and verified)
TEMPERATURE_SENSOR_INSTALLED="false"
PH_SENSOR_INSTALLED="false"
DEPTH_SENSOR_INSTALLED="false"
GPS_MODULE_INSTALLED="false"
ULTRASONIC_SENSOR_INSTALLED="false"
BATTERY_SENSE_INSTALLED="false"

# Stage-1 Bench Propulsion Safety Gate
# Set PROPULSION_CONFIRMED="true" ONLY after verifying L298N wiring, 3S LiPo fuse,
# external 5V UBEC for MG90S servo, and common GND on a dry test stand.
PROPULSION_CONFIRMED="false"
L298N_MODULE_COUNT="1"
STAGE1_MAX_PWM="140"
STAGE1_MAX_DURATION_MS="2000"
STAGE1_SERVO_MIN_DEG="45"
STAGE1_SERVO_MAX_DEG="135"

# AI-Thinker ESP32-CAM Default Local Endpoints (Optional)
ESP32_CAM_STREAM_URL=""
ESP32_CAM_SNAPSHOT_URL=""
ESP32_CAM_TIMEOUT_MS="5000"

